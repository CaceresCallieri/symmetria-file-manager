{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/fm-core": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "app": {
      "entry": ["src/main/index.ts", "src/preload/index.ts", "src/renderer/main.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    }
  },
  "ignore": [
    "plugin/third_party/**",
    "plugin/build/**",
    "qml/**",
    "docs/**",
    "tools/oxlint/anti-slop/**"
  ],
  "ignoreDependencies": ["@oxlint/plugins"]
}
