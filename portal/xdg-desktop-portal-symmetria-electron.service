[Unit]
Description=Symmetria Portal FileChooser backend (Electron build)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.symmetria-electron
Environment=SYMMETRIA_PORTAL_FM_CLI=%h/.local/bin/symmetria-fm-electron-cli
Environment=SYMMETRIA_PORTAL_BUS_NAME=org.freedesktop.impl.portal.desktop.symmetria-electron
ExecStart=%h/.local/share/symmetria/portal-venv/bin/python3 /usr/lib/symmetria/symmetria_electron_portal.py
Restart=on-failure

[Install]
WantedBy=graphical-session.target
